{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_BRAND": "hasiptech" }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": { "APP_BRAND": "hasiptech" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_BRAND": "hasiptech" }
    },
    "hasiptech": {
      "extends": "production",
      "env": { "APP_BRAND": "hasiptech" }
    }
  },
  "submit": {
    "production": {}
  }
}
